<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rise Network — Play. Compete. Conquer.</title>
<meta name="description" content="Rise Network is a growing Minecraft network built around competitive BedWars, immersive Survival SMP, and more gamemodes to come. Join risesmp.online.">

<!-- ============================================================
     FONTS
     Display: Space Grotesk (blocky, geometric, techy — echoes
     Minecraft's angular voxel forms without leaning on a literal
     pixel font). Body: Inter. Mono: JetBrains Mono, used for the
     server-IP / stat / "terminal" language of the site.
     ============================================================ -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* ================================================================
   DESIGN TOKENS
   ================================================================ */
:root{
  --void:#0a0c10;
  --panel:#12151b;
  --panel-alt:#171b22;
  --border:#232932;
  --border-soft:#1b2028;

  --gold:#e8a33d;
  --gold-soft:#f2c374;
  --teal:#3ddcc8;
  --teal-dim:#276b62;

  --text:#e9ebee;
  --text-dim:#98a1ac;
  --text-faint:#5f6771;

  --font-display:'Space Grotesk', sans-serif;
  --font-body:'Inter', sans-serif;
  --font-mono:'JetBrains Mono', monospace;

  --notch:14px;
  --radius:2px;
  --maxw:1180px;
}

*{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; }
body{
  background:var(--void);
  color:var(--text);
  font-family:var(--font-body);
  line-height:1.6;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
ul{ list-style:none; }
button{ font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }

::selection{ background:var(--gold); color:var(--void); }

/* Keyboard focus visibility */
a:focus-visible, button:focus-visible, input:focus-visible{
  outline:2px solid var(--teal);
  outline-offset:3px;
}

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
}

.wrap{ max-width:var(--maxw); margin:0 auto; padding:0 28px; }

/* subtle background grid texture, evokes a voxel/build-grid */
.grid-texture{
  position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:
    linear-gradient(rgba(232,163,61,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(232,163,61,0.035) 1px, transparent 1px);
  background-size:42px 42px;
  mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 85%);
}

#particle-canvas{
  position:fixed; inset:0; z-index:0; pointer-events:none; opacity:0.55;
}

/* ================================================================
   EYEBROW / LABEL SYSTEM
   ================================================================ */
.eyebrow{
  font-family:var(--font-mono);
  font-size:12px;
  letter-spacing:0.18em;
  text-transform:uppercase;
  color:var(--teal);
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:14px;
}
.eyebrow::before{
  content:"";
  width:18px; height:2px;
  background:var(--teal);
}

.section-title{
  font-family:var(--font-display);
  font-weight:700;
  font-size:clamp(28px, 4.2vw, 44px);
  letter-spacing:-0.01em;
  margin-bottom:16px;
}
.section-lede{
  color:var(--text-dim);
  max-width:640px;
  font-size:16px;
  margin-bottom:48px;
}
section{ position:relative; z-index:1; padding:100px 0; }
.section-alt{ background:linear-gradient(180deg, transparent, rgba(255,255,255,0.012) 15%, rgba(255,255,255,0.012) 85%, transparent); }

/* ================================================================
   VOXEL PANEL — the site's signature surface treatment.
   Notched corners (top-left / bottom-right) stand in for a
   Minecraft inventory-slot silhouette, rendered as a clean,
   modern glass panel rather than a literal pixel skeuomorph.
   ================================================================ */
.voxel{
  clip-path: polygon(
    var(--notch) 0, 100% 0, 100% calc(100% - var(--notch)),
    calc(100% - var(--notch)) 100%, 0 100%, 0 var(--notch)
  );
  background:linear-gradient(160deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
  background-color:var(--panel);
  border:1px solid var(--border);
  position:relative;
}
.voxel::before{
  /* corner accent ticks */
  content:"";
  position:absolute; top:0; left:0;
  width:var(--notch); height:1px;
  background:var(--gold);
  transform:translate(-1px, -1px) rotate(45deg);
  transform-origin:left top;
  width:20px;
}

/* ================================================================
   BUTTONS
   ================================================================ */
.btn{
  font-family:var(--font-mono);
  font-size:13px;
  font-weight:600;
  letter-spacing:0.06em;
  text-transform:uppercase;
  padding:15px 30px;
  display:inline-flex;
  align-items:center;
  gap:10px;
  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  transition:transform 0.15s ease, box-shadow 0.25s ease, background 0.25s ease;
  min-height:48px;
  white-space:nowrap;
}
.btn:active{ transform:translateY(1px) scale(0.99); }

.btn-primary{
  background:var(--gold);
  color:#1a1305;
}
.btn-primary:hover{
  background:var(--gold-soft);
  box-shadow:0 0 0 1px var(--gold-soft), 0 8px 24px -8px rgba(232,163,61,0.55);
}

.btn-ghost{
  background:transparent;
  border:1px solid var(--border);
  color:var(--text);
}
.btn-ghost:hover{
  border-color:var(--teal);
  color:var(--teal);
  box-shadow:0 8px 24px -12px rgba(61,220,200,0.35);
}

.btn-teal{
  background:var(--teal);
  color:#062723;
}
.btn-teal:hover{ background:#5be8d6; box-shadow:0 8px 24px -8px rgba(61,220,200,0.5); }

/* ================================================================
   NAVIGATION
   ================================================================ */
header{
  position:fixed; top:0; left:0; right:0; z-index:100;
  background:rgba(10,12,16,0.72);
  backdrop-filter:blur(14px) saturate(140%);
  border-bottom:1px solid var(--border-soft);
  transition:border-color 0.3s ease, background 0.3s ease;
}
.nav-inner{
  max-width:var(--maxw); margin:0 auto; padding:0 28px;
  display:flex; align-items:center; justify-content:space-between;
  height:72px;
}
.brand{
  font-family:var(--font-display);
  font-weight:700;
  font-size:19px;
  letter-spacing:0.01em;
  display:flex; align-items:center; gap:10px;
}
.brand .mark{
  width:11px; height:11px;
  background:var(--gold);
  clip-path:polygon(3px 0,100% 0,100% calc(100% - 3px),calc(100% - 3px) 100%,0 100%,0 3px);
  flex-shrink:0;
}
.brand .accent{ color:var(--gold); }

.nav-links{
  display:flex; align-items:center; gap:2px;
}
.nav-links a{
  font-family:var(--font-mono);
  font-size:12.5px;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--text-dim);
  padding:10px 14px;
  position:relative;
  transition:color 0.2s ease;
}
.nav-links a:hover{ color:var(--text); }
.nav-links a::after{
  content:"";
  position:absolute; left:14px; right:14px; bottom:6px;
  height:1px; background:var(--gold);
  transform:scaleX(0); transform-origin:left;
  transition:transform 0.25s ease;
}
.nav-links a:hover::after{ transform:scaleX(1); }

.nav-cta{ display:flex; align-items:center; gap:10px; }
.nav-cta .btn{ padding:11px 18px; font-size:11.5px; }

.hamburger{
  display:none;
  flex-direction:column;
  justify-content:center;
  gap:5px;
  width:40px; height:40px;
  align-items:center;
}
.hamburger span{
  width:22px; height:2px;
  background:var(--text);
  transition:transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
}
.hamburger.open span:nth-child(1){ transform:translateY(7px) rotate(45deg); background:var(--gold); }
.hamburger.open span:nth-child(2){ opacity:0; }
.hamburger.open span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); background:var(--gold); }

.mobile-menu{
  position:fixed; top:72px; left:0; right:0; bottom:0;
  background:rgba(10,12,16,0.98);
  backdrop-filter:blur(10px);
  z-index:99;
  display:flex; flex-direction:column;
  padding:20px 28px 40px;
  gap:2px;
  transform:translateX(100%);
  transition:transform 0.35s cubic-bezier(.22,.9,.32,1);
  overflow-y:auto;
}
.mobile-menu.open{ transform:translateX(0); }
.mobile-menu a{
  font-family:var(--font-display);
  font-weight:600;
  font-size:22px;
  padding:16px 4px;
  border-bottom:1px solid var(--border-soft);
  color:var(--text);
  opacity:0;
  transform:translateY(8px);
}
.mobile-menu.open a{ animation:mm-in 0.4s ease forwards; }
.mobile-menu.open a:nth-child(1){ animation-delay:0.05s; }
.mobile-menu.open a:nth-child(2){ animation-delay:0.10s; }
.mobile-menu.open a:nth-child(3){ animation-delay:0.15s; }
.mobile-menu.open a:nth-child(4){ animation-delay:0.20s; }
.mobile-menu.open a:nth-child(5){ animation-delay:0.25s; }
.mobile-menu.open a:nth-child(6){ animation-delay:0.30s; }
.mobile-menu.open a:nth-child(7){ animation-delay:0.35s; }
.mobile-menu.open a:nth-child(8){ animation-delay:0.40s; }
.mobile-menu.open a:nth-child(9){ animation-delay:0.45s; }
@keyframes mm-in{ to{ opacity:1; transform:translateY(0); } }
.mobile-menu .btn{ margin-top:24px; justify-content:center; }

/* ================================================================
   HERO
   ================================================================ */
.hero{
  position:relative; z-index:1;
  min-height:100vh;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center;
  padding:140px 28px 80px;
}
.hero-eyebrow{
  font-family:var(--font-mono);
  font-size:13px;
  letter-spacing:0.22em;
  color:var(--teal);
  text-transform:uppercase;
  margin-bottom:26px;
  opacity:0;
  animation:fade-up 0.7s ease 0.1s forwards;
}
.hero h1{
  font-family:var(--font-display);
  font-weight:700;
  font-size:clamp(52px, 11vw, 118px);
  line-height:0.95;
  letter-spacing:-0.02em;
  color:var(--text);
  opacity:0;
  animation:fade-up 0.8s ease 0.22s forwards;
}
.hero h1 .accent{
  color:var(--gold);
  position:relative;
}
.hero-tagline{
  font-family:var(--font-mono);
  font-size:clamp(13px, 2vw, 16px);
  letter-spacing:0.32em;
  color:var(--text-dim);
  margin-top:22px;
  text-transform:uppercase;
  opacity:0;
  animation:fade-up 0.8s ease 0.34s forwards;
}
.hero-desc{
  max-width:620px;
  margin:32px auto 0;
  color:var(--text-dim);
  font-size:16.5px;
  opacity:0;
  animation:fade-up 0.8s ease 0.46s forwards;
}
.hero-actions{
  display:flex; gap:14px; flex-wrap:wrap; justify-content:center;
  margin-top:44px;
  opacity:0;
  animation:fade-up 0.8s ease 0.58s forwards;
}
@keyframes fade-up{
  from{ opacity:0; transform:translateY(18px); }
  to{ opacity:1; transform:translateY(0); }
}

/* server IP pill + status */
.hero-server{
  margin-top:56px;
  display:flex; flex-direction:column; align-items:center; gap:14px;
  opacity:0;
  animation:fade-up 0.8s ease 0.7s forwards;
}
.ip-pill{
  font-family:var(--font-mono);
  font-size:15px;
  background:var(--panel);
  border:1px solid var(--border);
  padding:14px 20px;
  display:flex; align-items:center; gap:14px;
  clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
}
.ip-pill .dot{ width:7px; height:7px; border-radius:50%; background:var(--teal); flex-shrink:0; }
.ip-pill .val{ color:var(--gold-soft); letter-spacing:0.02em; }
.ip-pill button{
  font-family:var(--font-mono);
  font-size:11px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--text-dim);
  border-left:1px solid var(--border);
  padding-left:14px;
  transition:color 0.2s ease;
}
.ip-pill button:hover{ color:var(--teal); }

.status-line{
  font-family:var(--font-mono);
  font-size:12.5px;
  color:var(--text-faint);
  letter-spacing:0.04em;
}
.status-line .dot-live{
  width:6px;height:6px;border-radius:50%;
  background:var(--text-faint);
  display:inline-block;
  margin-right:8px;
}

.scroll-cue{
  position:absolute; bottom:34px; left:50%; transform:translateX(-50%);
  font-family:var(--font-mono);
  font-size:11px;
  color:var(--text-faint);
  letter-spacing:0.15em;
  text-transform:uppercase;
  display:flex; flex-direction:column; align-items:center; gap:8px;
  animation:bob 2.4s ease-in-out infinite;
}
.scroll-cue .line{ width:1px; height:26px; background:linear-gradient(var(--gold), transparent); }
@keyframes bob{ 0%,100%{ transform:translate(-50%,0); } 50%{ transform:translate(-50%,6px); } }

/* ================================================================
   REVEAL ON SCROLL
   ================================================================ */
.reveal{ opacity:0; transform:translateY(24px); transition:opacity 0.7s ease, transform 0.7s ease; }
.reveal.in{ opacity:1; transform:translateY(0); }
.reveal-stagger > *{ opacity:0; transform:translateY(20px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal-stagger.in > *{ opacity:1; transform:translateY(0); }
.reveal-stagger.in > *:nth-child(1){ transition-delay:0.03s; }
.reveal-stagger.in > *:nth-child(2){ transition-delay:0.09s; }
.reveal-stagger.in > *:nth-child(3){ transition-delay:0.15s; }
.reveal-stagger.in > *:nth-child(4){ transition-delay:0.21s; }
.reveal-stagger.in > *:nth-child(5){ transition-delay:0.27s; }
.reveal-stagger.in > *:nth-child(6){ transition-delay:0.33s; }
.reveal-stagger.in > *:nth-child(7){ transition-delay:0.39s; }
.reveal-stagger.in > *:nth-child(8){ transition-delay:0.45s; }
.reveal-stagger.in > *:nth-child(9){ transition-delay:0.51s; }
.reveal-stagger.in > *:nth-child(10){ transition-delay:0.57s; }
.reveal-stagger.in > *:nth-child(11){ transition-delay:0.63s; }

/* ================================================================
   ABOUT
   ================================================================ */
.about-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
  gap:1px;
  background:var(--border);
  border:1px solid var(--border);
}
.about-card{
  background:var(--void);
  padding:32px 26px;
  transition:background 0.25s ease;
}
.about-card:hover{ background:var(--panel); }
.about-card .num{
  font-family:var(--font-mono);
  font-size:12px;
  color:var(--teal);
  letter-spacing:0.1em;
}
.about-card h3{
  font-family:var(--font-display);
  font-size:19px;
  margin:14px 0 10px;
}
.about-card p{ color:var(--text-dim); font-size:14.5px; }

.about-lead{
  max-width:760px;
  color:var(--text-dim);
  font-size:16.5px;
  margin-bottom:56px;
}

/* ================================================================
   GAMEMODES
   ================================================================ */
.gm-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));
  gap:22px;
}
.gm-card{
  padding:36px 30px;
  transition:transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  overflow:hidden;
}
.gm-card:hover{
  transform:translateY(-6px);
  border-color:var(--gold);
  box-shadow:0 20px 40px -20px rgba(0,0,0,0.6);
}
.gm-icon{
  width:52px; height:52px;
  display:flex; align-items:center; justify-content:center;
  background:rgba(232,163,61,0.08);
  border:1px solid var(--border);
  margin-bottom:24px;
  clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px);
}
.gm-icon svg{ width:26px; height:26px; stroke:var(--gold); }
.gm-card h3{
  font-family:var(--font-display);
  font-weight:700;
  font-size:23px;
  margin-bottom:12px;
  letter-spacing:-0.01em;
}
.gm-card p{ color:var(--text-dim); font-size:15px; margin-bottom:20px; }
.gm-tag{
  font-family:var(--font-mono);
  font-size:11px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--teal);
  display:inline-flex; align-items:center; gap:8px;
}
.gm-tag::before{ content:"›"; color:var(--gold); }
.gm-card.soon{ opacity:0.7; }
.gm-card.soon .gm-icon svg{ stroke:var(--text-dim); }
.gm-card.soon:hover{ transform:none; border-color:var(--border); box-shadow:none; }

/* ================================================================
   SERVER INFO
   ================================================================ */
.info-panel{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px,1fr));
  border:1px solid var(--border);
  background:var(--panel);
}
.info-cell{
  padding:34px 30px;
  border-right:1px solid var(--border);
  border-bottom:1px solid var(--border);
}
.info-cell:last-child{ border-right:none; }
.info-cell .label{
  font-family:var(--font-mono);
  font-size:11.5px;
  letter-spacing:0.12em;
  text-transform:uppercase;
  color:var(--text-faint);
  margin-bottom:12px;
}
.info-cell .value{
  font-family:var(--font-mono);
  font-size:22px;
  color:var(--gold-soft);
  word-break:break-word;
}
.info-cell .value.small{ font-size:18px; color:var(--text); }
.info-cell.action{ display:flex; align-items:center; }

/* ================================================================
   FEATURES
   ================================================================ */
.feat-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
  gap:18px;
}
.feat-card{
  padding:28px 26px;
  transition:border-color 0.25s ease, transform 0.25s ease;
}
.feat-card:hover{ border-color:var(--teal); transform:translateY(-3px); }
.feat-card .fi{
  width:34px; height:34px;
  margin-bottom:18px;
  display:flex; align-items:center; justify-content:center;
}
.feat-card .fi svg{ width:22px; height:22px; stroke:var(--teal); }
.feat-card h4{ font-family:var(--font-display); font-size:16.5px; margin-bottom:8px; }
.feat-card p{ color:var(--text-dim); font-size:13.8px; }

/* ================================================================
   RULES
   ================================================================ */
.rules-list{
  display:grid;
  gap:1px;
  background:var(--border);
  border:1px solid var(--border);
}
.rule-row{
  background:var(--void);
  display:grid;
  grid-template-columns:90px 1fr;
  transition:background 0.2s ease;
}
.rule-row:hover{ background:var(--panel); }
.rule-num{
  font-family:var(--font-mono);
  font-size:13px;
  color:var(--gold);
  padding:26px 20px;
  border-right:1px solid var(--border);
  display:flex; align-items:flex-start;
}
.rule-body{ padding:26px 26px 26px 24px; }
.rule-body h4{ font-family:var(--font-display); font-size:16.5px; margin-bottom:6px; letter-spacing:0.01em; }
.rule-body p{ color:var(--text-dim); font-size:14px; }

/* ================================================================
   STAFF
   ================================================================ */
.staff-group{ margin-bottom:46px; }
.staff-group-title{
  font-family:var(--font-mono);
  font-size:12px;
  letter-spacing:0.16em;
  text-transform:uppercase;
  color:var(--text-faint);
  padding-bottom:14px;
  margin-bottom:22px;
  border-bottom:1px solid var(--border-soft);
  display:flex; align-items:center; gap:10px;
}
.staff-group-title .swatch{ width:8px; height:8px; background:var(--gold); flex-shrink:0; }
.staff-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
  gap:14px;
}
.staff-card{
  padding:22px 20px;
  transition:transform 0.2s ease, border-color 0.2s ease;
  display:flex; flex-direction:column; gap:10px;
}
.staff-card:hover{ transform:translateY(-4px); border-color:var(--gold); }
.staff-avatar{
  width:38px; height:38px;
  background:linear-gradient(135deg, rgba(232,163,61,0.18), rgba(61,220,200,0.1));
  border:1px solid var(--border);
  display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-weight:700; font-size:14px;
  color:var(--gold-soft);
  clip-path:polygon(5px 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%,0 5px);
}
.staff-name{ font-family:var(--font-display); font-weight:600; font-size:15.5px; }
.staff-role{
  font-family:var(--font-mono);
  font-size:10.5px;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--teal);
}
.staff-card.vacant{
  opacity:0.55;
  display:flex; align-items:center; justify-content:center; text-align:center;
}
.staff-card.vacant p{
