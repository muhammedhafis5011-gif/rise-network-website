  position:relative;
}
.discord-panel::after{
  content:"";
  position:absolute; top:0; right:0; bottom:0; width:40%;
  background:radial-gradient(ellipse at right, rgba(61,220,200,0.08), transparent 70%);
  pointer-events:none;
}
.discord-text{ max-width:520px; position:relative; z-index:1; }
.discord-text h2{
  font-family:var(--font-display); font-weight:700; font-size:clamp(26px,3.4vw,36px);
  margin-bottom:16px;
}
.discord-text p{ color:var(--text-dim); font-size:15.5px; }
.discord-actions{ position:relative; z-index:1; }

/* ================================================================
   STORE
   ================================================================ */
.store-panel{
  padding:90px 40px;
  text-align:center;
  position:relative;
}
.store-panel h2{
  font-family:var(--font-display); font-weight:700;
  font-size:clamp(30px,4vw,42px);
  margin-bottom:14px;
}
.store-panel p{ color:var(--text-dim); max-width:480px; margin:0 auto 30px; }
.store-tags{
  display:flex; gap:10px; justify-content:center; flex-wrap:wrap;
}
.store-tag{
  font-family:var(--font-mono);
  font-size:11px;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--text-faint);
  border:1px dashed var(--border);
  padding:8px 14px;
}

/* ================================================================
   TOAST NOTIFICATION
   ================================================================ */
#toast{
  position:fixed;
  bottom:28px; left:50%;
  transform:translate(-50%, 20px);
  background:var(--gold);
  color:#1a1305;
  font-family:var(--font-mono);
  font-size:13px;
  font-weight:600;
  letter-spacing:0.04em;
  padding:14px 22px;
  clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);
  display:flex; align-items:center; gap:10px;
  opacity:0;
  pointer-events:none;
  transition:opacity 0.3s ease, transform 0.3s ease;
  z-index:999;
  box-shadow:0 12px 30px -10px rgba(0,0,0,0.5);
}
#toast.show{ opacity:1; transform:translate(-50%, 0); }

/* ================================================================
   FOOTER
   ================================================================ */
footer{
  position:relative; z-index:1;
  border-top:1px solid var(--border-soft);
  padding:60px 0 34px;
}
.footer-top{
  display:flex; justify-content:space-between; flex-wrap:wrap; gap:40px;
  padding-bottom:40px;
}
.footer-brand .brand{ margin-bottom:10px; }
.footer-brand p{ color:var(--text-faint); font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; text-transform:uppercase; }
.footer-brand .ip{ margin-top:16px; font-family:var(--font-mono); font-size:13px; color:var(--gold-soft); }
.footer-cols{ display:flex; gap:60px; flex-wrap:wrap; }
.footer-col h5{
  font-family:var(--font-mono); font-size:11px; letter-spacing:0.12em; text-transform:uppercase;
  color:var(--text-faint); margin-bottom:16px;
}
.footer-col a{
  display:block; color:var(--text-dim); font-size:14px; padding:6px 0;
  transition:color 0.2s ease;
}
.footer-col a:hover{ color:var(--gold-soft); }
.footer-bottom{
  border-top:1px solid var(--border-soft);
  padding-top:26px;
  display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;
